@page
@model nhom1dotnet.Pages_Customers.DetailsModel

@{
    ViewData["Title"] = "Details";
}
<link rel="stylesheet" href="~/css/create.css" asp-append-version="true" />

<div class="page-header">
    <h1 class="page-title">
        <i class="fa-solid fa-info-circle"></i> Chi tiết khách hàng
    </h1>
    <a class="btn-back" asp-page="/Customers/Index">Quay lại</a>
</div>

<form class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Customer.id" />

    <div class="form-group">
        <label>Họ và tên</label>
        <div class="form-value">@Model.Customer.full_name</div>
    </div>

    <div class="form-group">
        <label>Số điện thoại</label>
        <div class="form-value">@Model.Customer.phone</div>
    </div>

    <div class="form-group">
        <label>Email</label>
        <div class="form-value">@Model.Customer.email</div>
    </div>

    <div class="form-group">
        <label>Địa chỉ</label>
        <div class="form-value">@Model.Customer.address</div>
    </div>

    <div class="form-group">
        <label>CMND/CCCD</label>
        <div class="form-value">@Model.Customer.citizen_id</div>
    </div>


    
</form>

