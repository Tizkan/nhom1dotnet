@page
@model nhom1dotnet.Pages_Customers.IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="customer-dashboard">
    <div class="dashboard-header">
        <div>
            <h1 class="page-title">Quản lý khách hàng</h1>
        </div>
        <div>
            <a asp-page="./Create" class="btn btn-primary btn-create-customer">+ Thêm khách hàng</a>
        </div>
    </div>

    <div class="summary-cards">
        <div class="stat-card">
            <div class="stat-icon blue">KH</div>
            <div class="stat-content">
                <p class="stat-label">Tổng khách hàng</p>
                <h2 class="stat-value">@Model.TotalCustomers</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">VIP</div>
            <div class="stat-content">
                <p class="stat-label">Khách VIP</p>
                <h2 class="stat-value">@Model.VipCustomers</h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">₫</div>
            <div class="stat-content">
                <p class="stat-label">Tổng doanh thu</p>
                <h2 class="stat-value" style="color:#16a34a;">@string.Format("{0:N0} đ", Model.TotalRevenue)</h2>
            </div>
        </div>
    </div>

    <div class="search-panel">
        <form method="get" class="search-form">
            <input asp-for="SearchString" class="form-control search-input" placeholder="Tìm kiếm theo tên, số điện thoại hoặc email..." />
            <button type="submit" class="btn btn-search">Tìm kiếm</button>
        </form>
    </div>

    <div class="table-responsive customer-table-wrapper">
        <table class="table customer-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Liên hệ</th>
                    <th>CMND/CCCD</th>
                    <th>Số lần đặt</th>
                    <th>Tổng chi tiêu</th>
                    <th>Gần đây</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Customers)
                {
                    <tr>
                        <td>
                            <div class="customer-name-cell">
                                <div class="customer-avatar">@item.Initials</div>
                                <div>
                                    <div class="customer-name">@item.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="contact-cell">
                                <span class="contact-phone">@item.Phone</span>
                                <span class="contact-email">@item.Email</span>
                            </div>
                        </td>
                        <td>@item.CitizenId</td>
                        <td><span class="booking-count">@item.BookingCount</span></td>
                        <td class="total-spent">@string.Format("{0:N0} đ", item.TotalSpent)</td>
                        <td>@(item.LastBooking.HasValue ? item.LastBooking.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td>
                            <div class="action-buttons">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="action-link view">Xem</a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="action-link edit">Sửa</a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="action-link delete">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>