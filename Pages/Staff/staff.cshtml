@page
@model nhom1dotnet.Pages_Staff.IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

@{
    ViewData["Title"] = "Quản lý nhân viên";

        string MaskKeep2(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "—";
        if (val.Length <= 2) return val;
        return val.Substring(0, 2) + new string('*', val.Length - 2);
    }

    string MaskFull(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "—";
        return new string('*', val.Length);
    }
}

<div class="staff-dashboard">
    <div class="dashboard-header">
        <div>
            <h1 class="page-title"><i class="fas fa-user-tie"></i> Quản lý nhân viên</h1>
        </div>
        <div>
            <button class="btn btn-primary btn-create-staff" onclick="openAddModal()">+ Thêm nhân viên</button>
        </div>
    </div>

    <div class="summary-cards">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-user-tie"></i></div>
            <div class="stat-content">
                <p class="stat-label">Tổng nhân viên</p>
                <h2 class="stat-value">@Model.TotalStaff</h2>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            <button class="btn-close-alert" onclick="this.parentElement.remove()">×</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error alert-dismissible">
            <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
            <button class="btn-close-alert" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <div class="search-panel">
        <form method="get" class="search-form">
            <input asp-for="SearchString" class="form-control search-input"
                   placeholder="Tìm kiếm theo tên, số điện thoại hoặc email..." />
            <button type="submit" class="btn btn-search">Tìm kiếm</button>
        </form>
    </div>

    <div class="table-responsive staff-table-wrapper">
        <table class="table staff-table">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Liên hệ</th>
                    <th>CMND/CCCD</th>
                    <th>Ngày sinh</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Staffs)
                {
                    <tr>
                        <td>
                            <div class="staff-name-cell">
                                <div class="staff-avatar">@item.Initials</div>
                                <div>
                                    <div class="staff-name">@item.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="contact-cell">
                                <span class="contact-phone">@MaskKeep2(item.Phone)</span>
                                <span class="contact-email">@MaskKeep2(item.Email)</span>
                            </div>
                        </td>
                        <td>@MaskKeep2(item.CitizenId)</td>
                        <td>@MaskFull(item.BirthDate.HasValue ? item.BirthDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-link view" type="button"
                                        data-id="@item.Id"
                                        data-fullname="@item.FullName"
                                        data-phone="@item.Phone"
                                        data-email="@item.Email"
                                        data-citizenid="@item.CitizenId"
                                        data-birthdate="@(item.BirthDate.HasValue ? item.BirthDate.Value.ToString("yyyy-MM-dd") : "")"
                                        data-createdat="@item.CreatedAt.ToString("yyyy-MM-dd")"
                                        onclick="openViewModal(this)">
                                    <i class="bi bi-eye-fill"></i>
                                    <span>Xem</span>
                                </button>

                                <button class="action-link edit" type="button"
                                        data-id="@item.Id"
                                        data-fullname="@item.FullName"
                                        data-phone="@item.Phone"
                                        data-email="@item.Email"
                                        data-citizenid="@item.CitizenId"
                                        data-birthdate="@(item.BirthDate.HasValue ? item.BirthDate.Value.ToString("yyyy-MM-dd") : "")"
                                        onclick="openEditModal(this)">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Sửa</span>
                                </button>

                                <button class="action-link delete" type="button"
                                        data-id="@item.Id"
                                        data-fullname="@item.FullName"
                                        onclick="openDeleteModal(this)">
                                    <i class="bi bi-trash-fill"></i>
                                    <span>Xóa</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Staffs.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:32px;color:#6b7280;">Chưa có nhân viên nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== MODAL XEM ===== -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-tie"></i> Chi tiết nhân viên</h3>
            <button class="modal-close" type="button" onclick="closeModal('viewModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="view-avatar-row">
                <div class="view-avatar" id="view_initials"></div>
                <div>
                    <div class="view-fullname" id="view_fullname"></div>
                    <div class="view-sub" id="view_email_sub"></div>
                </div>
            </div>
            <div class="view-grid">
                <div class="view-field">
                    <span class="view-label">Số điện thoại</span>
                    <span class="view-value" id="view_phone"></span>
                </div>
                <div class="view-field">
                    <span class="view-label">Email</span>
                    <span class="view-value" id="view_email"></span>
                </div>
                <div class="view-field">
                    <span class="view-label">CMND/CCCD</span>
                    <span class="view-value" id="view_citizenid"></span>
                </div>
                <div class="view-field">
                    <span class="view-label">Ngày sinh</span>
                    <span class="view-value" id="view_birthdate"></span>
                </div>
                <div class="view-field">
                    <span class="view-label">Ngày tạo</span>
                    <span class="view-value" id="view_createdat"></span>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-cancel" type="button" onclick="closeModal('viewModal')">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL THÊM ===== -->
<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-plus"></i> Thêm nhân viên</h3>
            <button class="modal-close" type="button" onclick="closeModal('addModal')">×</button>
        </div>
        <div class="modal-body">
            <form method="post" asp-page-handler="Add" id="addForm">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Họ và tên <span class="required">*</span></label>
                    <input type="text" name="fullname" class="form-control" placeholder="Nguyễn Văn A" required />
                </div>
                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <div class="email-otp-row">
                        <input type="email" name="email" id="add_email" class="form-control" placeholder="example@gmail.com" required />
                        <button type="button" class="btn-send-otp" id="btnAddSendOtp" onclick="sendAddOtp()">Gửi OTP</button>
                    </div>
                </div>
                <div class="form-group otp-group" id="addOtpGroup" style="display:none;">
                    <label>Mã OTP <span class="required">*</span></label>
                    <input type="text" id="add_otp_input" class="form-control" placeholder="Nhập mã 6 chữ số" maxlength="6" />
                    <div class="otp-timer" id="addOtpTimer"></div>
                    <div class="otp-status" id="addOtpStatus"></div>
                    <input type="hidden" name="otp_verified" id="add_otp_verified" value="false" />
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="phone" class="form-control" placeholder="0901234567" />
                </div>
                <div class="form-group">
                    <label>CMND/CCCD</label>
                    <input type="text" name="citizenid" class="form-control" placeholder="012345678901" />
                </div>
                <div class="form-group">
                    <label>Ngày sinh</label>
                    <input type="date" name="birthdate" class="form-control" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-cancel" onclick="closeModal('addModal')">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu nhân viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== MODAL SỬA ===== -->
<div class="modal-overlay" id="editModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-edit"></i> Sửa nhân viên</h3>
            <button class="modal-close" type="button" onclick="closeModal('editModal')">×</button>
        </div>
        <div class="modal-body">
            <form method="post" asp-page-handler="Edit" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit_id" />
                <div class="form-group">
                    <label>Họ và tên <span class="required">*</span></label>
                    <input type="text" name="fullname" id="edit_fullname" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <div class="email-otp-row">
                        <input type="email" name="email" id="edit_email" class="form-control" required />
                        <button type="button" class="btn-send-otp" id="btnEditSendOtp" onclick="sendEditOtp()">Gửi OTP</button>
                    </div>
                </div>
                <div class="form-group otp-group" id="editOtpGroup" style="display:none;">
                    <label>Mã OTP <span class="required">*</span></label>
                    <input type="text" id="edit_otp_input" class="form-control" placeholder="Nhập mã 6 chữ số" maxlength="6" />
                    <div class="otp-timer" id="editOtpTimer"></div>
                    <div class="otp-status" id="editOtpStatus"></div>
                    <input type="hidden" name="otp_verified" id="edit_otp_verified" value="false" />
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="phone" id="edit_phone" class="form-control" />
                </div>
                <div class="form-group">
                    <label>CMND/CCCD</label>
                    <input type="text" name="citizenid" id="edit_citizenid" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Ngày sinh</label>
                    <input type="date" name="birthdate" id="edit_birthdate" class="form-control" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-cancel" onclick="closeModal('editModal')">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== MODAL XÓA ===== -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box modal-sm">
        <div class="modal-header danger">
            <h3><i class="fas fa-user-minus"></i> Xác nhận xóa</h3>
            <button class="modal-close" type="button" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="delete-warning">
                <i class="fas fa-exclamation-triangle warning-icon"></i>
                <p>Bạn có chắc muốn xóa nhân viên <strong id="delete_name"></strong>?</p>
                <p class="delete-note">Hành động này không thể hoàn tác.</p>
            </div>
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="delete_id" />
                <div class="modal-actions">
                    <button type="button" class="btn btn-cancel" onclick="closeModal('deleteModal')">Hủy</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xóa nhân viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@emailjs/browser@4/dist/email.min.js"></script>
    <script src="~/js/staff.js" asp-append-version="true"></script>
}
