@page
@model nhom1dotnet.Pages_Staff.IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Quản lý nhân viên";

    string MaskKeep2(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "—";
        if (val.Length <= 2) return val;
        return val.Substring(0, 2) + new string('*', val.Length - 2);
    }

    string MaskFull(string? val)
    {
        if (string.IsNullOrEmpty(val)) return "—";
        return new string('*', val.Length);
    }
}

<div class="staff-dashboard">

    <!-- Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="page-title"><i class="fas fa-id-card"></i> Quản lý nhân viên</h1>
            <p class="page-subtitle">Thêm, chỉnh sửa và xóa thông tin nhân viên</p>
        </div>
        <button class="btn btn-primary btn-add" onclick="openAddModal()">
            <i class="fas fa-plus"></i> Thêm nhân viên
        </button>
    </div>

    <!-- Stats -->
    <div class="summary-cards">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-users"></i></div>
            <div class="stat-content">
                <p class="stat-label">Tổng nhân viên</p>
                <h2 class="stat-value">@Model.TotalStaff</h2>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            <button class="btn-close-alert" onclick="this.parentElement.remove()">×</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error alert-dismissible">
            <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
            <button class="btn-close-alert" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <!-- Search -->
    <div class="search-panel">
        <form method="get" class="search-form">
            <i class="fas fa-search search-icon"></i>
            <input asp-for="SearchString" class="form-control search-input"
                   placeholder="Tìm theo tên, email hoặc CCCD..." />
            <button type="submit" class="btn btn-search">Tìm kiếm</button>
        </form>
    </div>

    <!-- Table -->
    <div class="table-responsive staff-table-wrapper">
        <table class="table staff-table">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Email</th>
                    <th>Ngày sinh</th>
                    <th>CCCD</th>
                    <th>Số điện thoại</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Staffs)
                {
                    <tr>
                        <td>
                            <div class="staff-name-cell">
                                <div class="staff-avatar avatar-staff">
                                    @(string.Join("", s.full_name.Split(' ').Where(w => w.Length > 0).Select(w =>
                                w[0]).Take(2)).ToUpper())
                                </div>
                                <span class="staff-name">@s.full_name</span>
                            </div>
                        </td>
                        <td><span class="staff-email">@MaskKeep2(s.email)</span></td>
                        <td>@(s.birth_date.HasValue ? MaskFull(s.birth_date.Value.ToString("dd/MM/yyyy")) : "—")</td>
                        <td>@MaskKeep2(s.citizen_id)</td>
                        <td>@MaskKeep2(s.phone)</td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn btn-view"
                                        onclick="openViewModal(@s.id, '@s.full_name', '@s.email', '@(s.birth_date.HasValue ? s.birth_date.Value.ToString("dd/MM/yyyy") : "—")', '@(s.citizen_id ?? "—")', '@(s.phone ?? "—")', '@s.created_at.ToString("dd/MM/yyyy")')">
                                    <i class="fas fa-eye"></i> Xem
                                </button>
                                <button class="action-btn btn-edit"
                                        onclick="openEditModal(@s.id, '@s.full_name', '@s.email', '@(s.birth_date.HasValue ? s.birth_date.Value.ToString("yyyy-MM-dd") : "")', '@(s.citizen_id ?? "")', '@(s.phone ?? "")')">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                                <button class="action-btn btn-delete"
                                        onclick="openDeleteModal(@s.id, '@s.full_name', '@s.email')">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Staffs.Any())
                {
                    <tr>
                        <td colspan="6" class="no-data"><i class="fas fa-inbox"></i><br />Chưa có nhân viên nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Thêm -->
<div class="modal-overlay" id="addModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-plus"></i> Thêm nhân viên</h3>
            <button class="modal-close" onclick="closeModal('addModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Họ và tên <span class="required">*</span></label>
                <input type="text" id="add_fullname" class="form-control" placeholder="Nguyễn Văn A" />
            </div>
            <div class="form-group">
                <label>Ngày sinh</label>
                <input type="date" id="add_birthdate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <div class="input-otp-row">
                    <input type="email" id="add_email" class="form-control" placeholder="example@gmail.com" />
                    <button class="btn btn-otp" id="btnSendOtp" onclick="sendOtp()">Gửi OTP</button>
                </div>
                <small class="hint-text" id="otpHint"></small>
            </div>
            <div class="form-group" id="otpGroup" style="display:none">
                <label>Mã OTP <span class="required">*</span></label>
                <input type="text" id="add_otp" class="form-control otp-input" maxlength="6"
                       placeholder="Nhập mã 6 số" />
                <small class="hint-text">OTP có hiệu lực trong 2 phút.</small>
            </div>
            <div class="form-group" id="verifiedGroup" style="display:none">
                <div class="verified-badge"><i class="fas fa-check-circle"></i> Email đã xác thực</div>
            </div>
            <div class="form-group">
                <label>Số CCCD</label>
                <input type="text" id="add_citizenid" class="form-control" placeholder="012345678901" />
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" id="add_phone" class="form-control" placeholder="0901234567" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-cancel" onclick="closeModal('addModal')">Hủy</button>
                <button class="btn btn-primary" onclick="submitAdd()">
                    <i class="fas fa-save"></i> Lưu nhân viên
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Sửa -->
<div class="modal-overlay" id="editModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user-edit"></i> Sửa nhân viên</h3>
            <button class="modal-close" onclick="closeModal('editModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="edit_id" />
            <div class="form-group">
                <label>Họ và tên <span class="required">*</span></label>
                <input type="text" id="edit_fullname" class="form-control" />
            </div>
            <div class="form-group">
                <label>Ngày sinh</label>
                <input type="date" id="edit_birthdate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <div class="input-otp-row">
                    <input type="email" id="edit_email" class="form-control" />
                    <button class="btn btn-otp" id="btnEditSendOtp" onclick="sendEditOtp()">Gửi OTP</button>
                </div>
                <small class="hint-text" id="editOtpHint"></small>
            </div>
            <div class="form-group" id="editOtpGroup" style="display:none">
                <label>Mã OTP <span class="required">*</span></label>
                <input type="text" id="edit_otp" class="form-control otp-input" maxlength="6"
                       placeholder="Nhập mã 6 số" />
            </div>
            <div class="form-group" id="editVerifiedGroup" style="display:none">
                <div class="verified-badge"><i class="fas fa-check-circle"></i> Email đã xác thực</div>
            </div>
            <div class="form-group">
                <label>Số CCCD</label>
                <input type="text" id="edit_citizenid" class="form-control" />
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" id="edit_phone" class="form-control" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-cancel" onclick="closeModal('editModal')">Hủy</button>
                <button class="btn btn-primary" onclick="submitEdit()">
                    <i class="fas fa-save"></i> Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Xóa -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box modal-sm">
        <div class="modal-header danger">
            <h3><i class="fas fa-user-minus"></i> Xác nhận xóa</h3>
            <button class="modal-close" onclick="closeModal('deleteModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="delete-warning">
                <i class="fas fa-exclamation-triangle warning-icon"></i>
                <p>Bạn có chắc muốn xóa nhân viên <strong id="delete_name"></strong>?</p>
                <p class="delete-note">Hành động này không thể hoàn tác.</p>
            </div>
            <input type="hidden" id="delete_id" />
            <div class="modal-actions">
                <button class="btn btn-cancel" onclick="closeModal('deleteModal')">Hủy</button>
                <button class="btn btn-danger" onclick="submitDelete()">
                    <i class="fas fa-trash"></i> Xóa nhân viên
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Xem -->
<div class="modal-overlay" id="viewModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fas fa-user"></i> Thông tin nhân viên</h3>
            <button class="modal-close" onclick="closeModal('viewModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="view-info-grid">
                <div class="view-info-item">
                    <span class="view-label">Họ và tên</span>
                    <span class="view-value" id="view_fullname"></span>
                </div>
                <div class="view-info-item">
                    <span class="view-label">Email</span>
                    <span class="view-value" id="view_email"></span>
                </div>
                <div class="view-info-item">
                    <span class="view-label">Ngày sinh</span>
                    <span class="view-value" id="view_birthdate"></span>
                </div>
                <div class="view-info-item">
                    <span class="view-label">Số CCCD</span>
                    <span class="view-value" id="view_citizenid"></span>
                </div>
                <div class="view-info-item">
                    <span class="view-label">Số điện thoại</span>
                    <span class="view-value" id="view_phone"></span>
                </div>
                <div class="view-info-item">
                    <span class="view-label">Ngày tạo</span>
                    <span class="view-value" id="view_createdat"></span>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-cancel" onclick="closeModal('viewModal')">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@emailjs/browser@@4/dist/email.min.js"></script>
    <script src="~/js/staff.js" asp-append-version="true"></script>
    @Html.AntiForgeryToken()
}
