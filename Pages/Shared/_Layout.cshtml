<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - nhom1dotnet</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings.css" />
    <link rel="stylesheet" href="~/nhom1dotnet.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="layout-container">

        <!-- Sidebar -->
        <aside class="sidebar">

            <!-- Logo -->
            <div class="logo">
                <h2>Nhất Thanh</h2>
                <p>Hệ thống quản lý khách sạn</p>
            </div>

            <!-- Menu -->
            <ul class="menu">

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                    <a asp-page="/Index">
                        <i class="fas fa-home"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Rooms/Room" ? "active" : "")">
                    <a asp-page="/Rooms/Room">
                        <i class="fa-solid fa-bed"></i>
                        <span>Quản lý phòng</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Booking/Booking" ? "active" : "")">
                    <a asp-page="/Booking/Booking">
                        <i class="fa-solid fa-calendar"></i>
                        <span>Đặt phòng</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Customers/Index" ? "active" : "")">
                    <a asp-page="/Customers/Index">
                        <i class="fa-solid fa-users"></i>
                        <span>Khách hàng</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Report/Report" ? "active" : "")">
                    <a asp-page="/Report/Report">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Báo cáo</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Index" ? "active" : "")">
                    <a asp-page="/Staff/staff">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Nhân viên</span>
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Settings/Settings" ? "active" : "")">
                    <a asp-page="/Settings/Settings">
                        <i class="fa-solid fa-gear"></i>
                        <span>Cài đặt</span>
                    </a>
                </li>

            </ul>

            <!-- User -->
            <div class="user-box">

                <div class="avatar">
                    A
                </div>

                <div>
                    <h5>Admin</h5>
                    <p>Quản trị viên</p>
                </div>

            </div>

        </aside>

        <!-- Main -->
        <main class="main-content">

            @RenderBody()

        </main>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
