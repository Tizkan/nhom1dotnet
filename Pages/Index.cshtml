@page
@model nhom1dotnet.Pages.IndexModel


@{
    ViewData["Title"] = "Tổng quan";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

<h1 class="page-title">
    <i class="fa-solid fa-chart-line"></i> Tổng quan hệ thống
</h1>

<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fa-solid fa-bed"></i>
        </div>
        <div class="stat-content">
            <p class="stat-label">Tổng phòng</p>
            <h3 class="stat-value">@Model.TotalRooms</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fa-solid fa-calendar-check"></i>
        </div>
        <div class="stat-content">
            <p class="stat-label">Tổng phòng đã đặt</p>
            <h3 class="stat-value">@Model.TotalBookings</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon purple">
            <i class="fa-solid fa-users"></i>
        </div>
        <div class="stat-content">
                <p class="stat-label">Tổng khách hàng</p>
                <h2 class="stat-value">@Model.TotalCustomers</h2>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fa-solid fa-dollar-sign"></i>
        </div>
        <div class="stat-content">
                <p class="stat-label">Tổng doanh thu</p>
                <h2 class="stat-value" style="color:#16a34a;">@string.Format("{0:N0} đ", Model.TotalRevenue)</h2>
        </div>
    </div>
</div>

<div class="dashboard-content">
    <!-- ── Hoạt động gần đây ── -->
        <div class="activity-card">
        <h3>Hoạt động gần đây</h3>

        @foreach (var activity in Model.RecentActivities)
        {
            <div class="activity-item">
                <div class="activity-time">
                    @activity.Time
                </div>

                <div class="activity-content">
                    <div class="activity-title">
                        @activity.Title
                    </div>

                    <div class="activity-user">
                        @activity.CustomerName
                    </div>
                </div>
            </div>
        }
        </div>
    <!-- ── Danh sách phòng trống ── -->
    <div class="room-card">
    <h3>Danh sách phòng trống</h3>

    @if (Model.AvailableRooms.Any())
    {
        @foreach (var room in Model.AvailableRooms)
        {
            <div class="room-item">
                <div class="room-number">
                    Phòng @room.room_number
                </div>

                <span class="room-type-badge room-type-@room.RoomType?.name">@room.RoomType?.name</span>
                
                <div class="room-status">
                    Trống
                </div>
            </div>
        }
    }
    else
    {
        <p>Không có phòng trống.</p>
    }
    </div>
</div>

</div>



