@page
@model nhom1dotnet.Pages.Booking.EditModel

@{
    ViewData["Title"] = "Sửa đặt phòng";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link rel="stylesheet" href="~/css/edit.css" asp-append-version="true" />

<div class="page-header">
    <h1 class="page-title">
        <i class="fa-solid fa-edit"></i> Cập nhật đặt phòng
    </h1>
    <a class="btn-back" asp-page="/Booking/Booking">
        <i class="fa-solid fa-arrow-left"></i> Quay lại
    </a>
</div>

<form method="post" class="form-card">

    <input type="hidden" asp-for="Booking.id" />

    <div class="form-group">
        <label>Khách hàng ID</label>
        <input asp-for="Booking.customer_id" type="number" />
    </div>

    <div class="form-group">
        <label>Phòng ID</label>
        <input asp-for="Booking.room_id" type="number" />
    </div>

    <div class="form-group">
        <label>Check-in</label>
        <input asp-for="Booking.check_in" type="date" />
    </div>

    <div class="form-group">
        <label>Check-out</label>
        <input asp-for="Booking.check_out" type="date" />
    </div>

    <div class="form-group">
        <label>Trạng thái</label>
        <select asp-for="Booking.status">
            <option value="">-- Chọn trạng thái --</option>
            <option value="Chờ xác nhận">Chờ xác nhận</option>
            <option value="Đã xác nhận">Đã xác nhận</option>
            <option value="Đã Check-in">Đã Check-in</option>
            <option value="Đã Check-out">Đã Check-out</option>
        </select>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-save">
            <i class="fa-solid fa-check"></i> Cập nhật
        </button>
        <a asp-page="/Booking/Booking" class="btn-cancel">
            <i class="fa-solid fa-times"></i> Hủy
        </a>
    </div>

</form>